# Keystatic GitHub mode (production only). Dev uses local mode with no env.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=JulioCesarRamirez/jcrj-portfolio
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Absolute site URL for metadata, sitemap and robots. On Vercel, falls back to the production or deployment host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" lets search engines index the site. Anything else: robots Disallow, noindex, empty sitemap.
# Preview deployments are never indexed.
SITE_PUBLIC=

# Set to github only when running `npm run dev:github` to create the Keystatic GitHub App.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
