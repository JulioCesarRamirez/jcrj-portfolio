# Keystatic GitHub mode (production only). Dev uses local mode with no env.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=owner/repo   # TODO(julio): set real owner/repo
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Absolute site URL for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to github only when running `npm run dev:github` to create the Keystatic GitHub App.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
